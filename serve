#!/usr/bin/env bash
set -euo pipefail

PORT="${1:-8080}"
HOST="${2:-127.0.0.1}"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "$DIR"

# Find a free port starting at PORT if PORT is already in use
while python3 - "$HOST" "$PORT" <<'PY' 2>/dev/null; do
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    s.bind((sys.argv[1], int(sys.argv[2])))
    sys.exit(1)  # port is free
except OSError:
    sys.exit(0)  # port is in use
finally:
    s.close()
PY
  PORT=$((PORT + 1))
done

echo "Serving $DIR at http://${HOST}:${PORT}/ (Ctrl+C to stop)"

if command -v python3 >/dev/null 2>&1; then
  exec python3 -m http.server "$PORT" --bind "$HOST"
elif command -v npx >/dev/null 2>&1; then
  exec npx --yes serve -l "tcp://${HOST}:${PORT}" .
elif command -v php >/dev/null 2>&1; then
  exec php -S "${HOST}:${PORT}" -t "$DIR"
else
  echo "Error: No local HTTP server found (install python3 or node)." >&2
  exit 1
fi
